<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/9.5/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         verbose="true"
         stopOnFailure="false">
    <testsuites>
        <testsuite name="Тесты Автосервиса">
            <directory>tests</directory>
        </testsuite>
    </testsuites>
    <coverage>
        <include>
            <directory suffix=".php">.</directory>
        </include>
        <exclude>
            <directory>vendor</directory>
            <directory>tests</directory>
            <directory>analytics</directory>
        </exclude>
        <report>
            <html outputDirectory="coverage/html"/>
            <text outputFile="coverage/text.txt"/>
            <clover outputFile="coverage/clover.xml"/>
        </report>
    </coverage>
    <logging>
        <junit outputFile="analytics/junit.xml"/>
        <testdoxHtml outputFile="analytics/testdox.html"/>
        <testdoxText outputFile="analytics/testdox.txt"/>
    </logging>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="DB_CONNECTION" value="testing"/>
        <env name="LANG" value="ru_RU.UTF-8"/>
        <env name="LC_ALL" value="ru_RU.UTF-8"/>
    </php>
</phpunit> 