{
    "name": "autoservice/tests",
    "description": "Тесты для сайта автосервиса",
    "type": "project",
    "require": {
        "php": ">=8.1",
        "phpunit/phpunit": "^9.6"
    },
    "require-dev": {
        "phpunit/php-code-coverage": "^9.2",
        "pcov/clobber": "^2.0"
    },
    "scripts": {
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-html coverage/html"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    }
} 